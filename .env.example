# Supabase Dashboard → Project Settings → API. These are public client identifiers.
# Do not put service_role or secret keys in EXPO_PUBLIC_* variables.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# AI_API_KEY, AI_MODEL and AI_BASE_URL belong only in Supabase Edge Function secrets.
# Never add them as EXPO_PUBLIC_* variables.
